// Optional tools below the decks when the library lives on another screen.
import { Theme } from "theme.slint";
import { ScrollView } from "scroll.slint";
import { SamplerPanel } from "sampler.slint";
import { InstrumentsPanel } from "instruments.slint";
import { LyricsPanel } from "lyrics.slint";
import { ChecklistPanel } from "checklist.slint";
import { PerformanceEffect } from "fxbar.slint";

export component PerformancePanel inherits Rectangle {
    in property <int> selected;
    in property <bool> four;
    in property <bool> prep;
    callback picked(int);
    background: Theme.panel;
    clip: true;
    VerticalLayout {
        spacing: 1px;
        Rectangle {
            height: 32px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                Text { text: "PERFORMANCE"; color: Theme.text-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; width: 100px; }
                for name[i] in ["Decks only", "Sampler", "Instruments", "Effects", "Lyrics", "Checklist"]: Rectangle {
                    visible: i != 5 || prep;
                    width: i == 5 && !prep ? 0px : label.preferred-width + 20px;
                    border-radius: 5px;
                    background: selected == i ? Theme.accent.with-alpha(0.2) : touch.has-hover ? Theme.control : transparent;
                    label := Text { text: name; color: selected == i ? Theme.accent : Theme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    touch := TouchArea { mouse-cursor: pointer; clicked => { picked(i); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        if selected != 0 && selected != 5: tool-scroll := ScrollView {
            content-width: self.visible-width;
            content-height: selected == 1 || selected == 3 ? max(self.visible-height, selected == 3 ? (four ? 352px : 176px) : 160px) : self.visible-height;
            Rectangle {
                width: tool-scroll.content-width;
                height: tool-scroll.content-height;
            if selected == 1: HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                for bank in 2: VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    preferred-width: 0px;
                    spacing: 4px;
                    Rectangle {
                        height: 18px;
                        Text { width: parent.width; text: bank == 0 ? "SAMPLER · BANK A" : "SAMPLER · BANK B"; color: Theme.text-dim; font-size: 10px; }
                    }
                    SamplerPanel { bank: bank; vertical-stretch: 1; }
                }
            }
            if selected == 2: InstrumentsPanel { decks: four ? 4 : prep ? 1 : 2; }
            if selected == 3: VerticalLayout {
                padding: 8px;
                spacing: 12px;
                alignment: start;
                for row in (four ? 2 : 1): HorizontalLayout {
                    spacing: 16px;
                    for column in (prep ? 1 : 2): VerticalLayout {
                        property <int> deck: four ? [2, 0, 1, 3][row * 2 + column] : column;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        spacing: 8px;
                        Rectangle {
                            height: 20px;
                            Text { width: parent.width; text: "DECK " + (deck + 1); color: Theme.deck-color(deck); font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for slot in 3: PerformanceEffect { unit: deck; slot: slot; tint: Theme.deck-color(deck); }
                        }
                    }
                }
            }
            if selected == 4: LyricsPanel { }
            }
        }
        if selected == 5: checklist-scroll := ScrollView {
            content-width: self.visible-width;
            content-height: max(self.visible-height, checklist.preferred-height);
            checklist := ChecklistPanel {
                width: checklist-scroll.content-width;
                height: checklist-scroll.content-height;
            }
        }
    }
}
